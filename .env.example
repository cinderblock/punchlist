# Copy to .env for local development. A deployment sets these in its own way
# (see Deployment in the README); this file is the annotated list of what the
# app reads from the environment. Everything about the space itself (its name,
# zones, labels, maps, integrations) lives in the YAML file at CONFIG_FILE.

# --- Required ---

# Public origin. This is the WebAuthn Relying Party ID and the base for one-time
# links, so it must match how the browser reaches the app, exactly: scheme and
# host, no path, no trailing slash. Passkeys are bound to it. Changing it later
# orphans every passkey.
PUBLIC_BASE_URL=http://localhost:3000

# Signs cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me

# --- Listening: a TCP port, or a unix socket ---
#PORT=3000
# When set, the app listens here instead of PORT, and the socket is made
# connectable by other users (the reverse proxy usually runs as someone else).
# A stale socket file is removed on start only if nothing is listening on it.
#SOCKET_PATH=/run/punchlist/punchlist.sock

# --- The anonymous on-site tier ---
# Name of a header your reverse proxy sets to exactly `lan` for requests that
# are physically on site, and strips from everything else. Unset (the default)
# means there is no anonymous tier at all and the header is ignored. Read
# "Running it for your own space" in the README before setting this: it is only
# sound when nothing but that proxy can reach the app.
#TRUSTED_PERIMETER_HEADER=X-Punchlist-Perimeter

# --- Storage ---
CONFIG_FILE=./examples/punchlist.yaml
DATABASE_PATH=./data/punchlist.db
# Defaults to an `attachments` directory beside the database.
#ATTACHMENTS_DIR=./data/attachments

# --- Web Push (optional; unset disables notifications entirely) ---
# 32 random bytes, base64url: e.g. openssl rand -base64 33 | tr '+/' '-_' | head -c 43
# (or the private half of: bunx web-push generate-vapid-keys). The public key is
# derived from it. Keep it: a new key silently orphans every subscribed device.
#VAPID_PRIVATE_KEY=
# Who push services contact about this sender (mailto: or https: only).
# Defaults to PUBLIC_BASE_URL when that is https; set it for an http address.
#VAPID_SUBJECT=
# How often due-soon and overdue reminders are checked for, in seconds; 0 = off.
#NOTIFY_EVERY_SECONDS=60

# --- Integrations ---
# Each integration in the YAML file names the variable that holds its token.
# The example file's is:
#INTEGRATION_MONITOR_TOKEN=
